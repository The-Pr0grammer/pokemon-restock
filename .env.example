# Which channels to send notifications through (comma-separated: discord, email, or both)
NOTIFY_CHANNELS=discord,email

# Discord webhook URL — create one in Server Settings > Integrations > Webhooks
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Email notifications (optional — set ENABLED=false to skip)
EMAIL_ENABLED=false
EMAIL_FROM=you@gmail.com
EMAIL_TO=you@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
# For Gmail: use an App Password, not your account password
# https://myaccount.google.com/apppasswords
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password

# Best Buy Developer API key (free at https://developer.bestbuy.com)
BESTBUY_API_KEY=

# Structured Pokemon market-price enrichment (free key available from pokemontcgapi.com)
# Store the real key only in your local environment / Render secrets.
PTCG_API_KEY=
PTCG_API_SEARCH_LIMIT=5
PTCG_API_MIN_MATCH_SCORE=0.72

# Structured market-price enrichment through JustTCG.
JUSTTCG_API_KEY=
JUSTTCG_SEARCH_LIMIT=10
JUSTTCG_MIN_MATCH_SCORE=0.72

# Opportunity sweep controls
OBSERVATION_SOURCE=all
MARKET_ENABLED=true
MARKET_PRICE_MAX_OBSERVATIONS=12
OPPORTUNITY_MIN_DISCOUNT_PCT=25
OPPORTUNITY_MIN_ABSOLUTE_SPREAD=10

# Toggle individual retailers (default: all enabled)
TARGET_ENABLED=true
WALMART_ENABLED=true
BESTBUY_ENABLED=true

# Search keywords (comma-separated, applied across all retailers)
SEARCH_KEYWORDS=pokemon trading card game,pokemon tcg booster,pokemon elite trainer box

# Only notify for products whose names contain these terms (case-insensitive, comma-separated)
# Leave blank to notify for all new products
FILTER_KEYWORDS=booster,elite trainer,etb,tin,collection

# How many pages to check per retailer per run
MAX_PAGES=3
